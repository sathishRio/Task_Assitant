# Where the API lives. Leave empty in development: Vite proxies /api to http://localhost:4000.
# Production builds use .env.production (VITE_API_URL=https://api.devobj.com).
VITE_API_URL= http://0.0.0.0:4000/api

# DevOBJ site for the header's "Town map" button (links to <url>/#town). Default: http://localhost:3000.
VITE_DEVOBJ_URL=
